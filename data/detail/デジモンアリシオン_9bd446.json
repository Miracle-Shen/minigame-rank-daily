 "play": {
  "core_loop": "用 50 张主卡组加 3–5 张数码蛋组牌，靠共享「记忆条」出牌：花得越多，回合越早交给对手。进化叠加继承效果，打穿对手 5 张 Security 就赢；每天领一包免费卡包，攒料补卡组。",
  "highlights": [
   "记忆条是共享的：一次大铺场等于把下回合的资源送给对手，「敢不敢多花 1 点」每回合都在拷问，这是本作最硬的决策点",
   "Security 当血条：被打中翻开的牌可能是救命反击，也可能什么都没有，翻牌那一下天然带赌感",
   "进化叠卡：往同色下层卡上进化会抽一张牌，并把下层效果堆成继承效果，构筑时能玩出层叠组合",
   "每日免费卡包加异画、动态异画，卡面本身就是收藏品，开包动力不依赖战力"
  ],
  "innovations": [
   "把实体卡的共享记忆条完整搬进数字端并做成双向可视刻度，让「资源即回合」的取舍在手机上看得见",
   "数字端与实体预组打通（预组内附兑换码），做成线上练手到线下买卡的漏斗，而不是替代关系"
  ],
  "target_user": "12-30 岁数码宝贝粉丝与实体 TCG 玩家，日本与欧美为主力市场",
  "monetization": "IAP 为主：卡包、预组套牌、活动通行证；每日免费卡包保底，无强制激励视频",
  "lifecycle": "长线运营：按实体卡池节奏（BD 系列、ST 预组）同步更新，内容供给天然跟得上"
 },
