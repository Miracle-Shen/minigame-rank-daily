 "play": {
  "core_loop": "每关给一张塞满杂物的手绘房间图和顶部清单（如泳圈 0/5、泳裙 0/4、发夹 0/6），玩家点选可见物件放进上方暂存栏，凑齐某一类配额就自动归集、腾出格位；被压住的物件要先挪走上层，而暂存栏只有 7 格，塞满就彻底动不了。",
  "highlights": [
   "「暂存栏只剩两格」的压迫感是这作最爽也最痛的地方——明明看见目标就在那，却因为刚才多点了一个果皮拿不出来",
   "凑齐一组后自动归集、格子回血的瞬间有明确的秩序感，这也是它区别于纯眼力找茬的核心反馈",
   "大件挪开后底层小件「露出来」的一刻很解压，遮挡关系本身就是奖励结构",
   "难度是铺好的：前期卧室桌堆少，中期上带图标的分类框（厨具归厨具、果蔬归果蔬），后期压格位 + 加计时"
  ],
  "innovations": [
   "给传统的「找物」加了一条容量约束：暂存区 7 格把无脑点击变成拾取顺序规划，这是本作与普通找茬最大的分水岭",
   "目标按「品类 + 配额」下发（0/7 比 0/4 深得多），玩家要自己判断先拆哪一堆，而不是看见什么捡什么"
  ],
  "target_user": "25-45 岁女性为主的生活化解压用户与 iPad 用户，碎片时间、睡前、通勤，不需要反应速度",
  "monetization": "IAA 为主：弹窗广告 + 看广告解锁提示/清理道具，商店页无去广告内购；差评集中骂的正是「时不时弹内部广告」与「想付费免广告都没入口」",
  "lifecycle": "短平快偏长线：上架一周靠免费榜冲量，后续靠关卡扩充（1.2 版本加了新关卡）与每日任务维持，缺少长线目标"
 },
 "clone": {
  "verdict": "变种创意",
  "rationale": "找物本身是零门槛的成熟玩法，代码量极小；真正有价值的是「暂存区容量」这一条结构约束，它把眼力游戏改成了顺序规划游戏，这条必须保留。但手绘场景是重美术投入（一关一张精修插画），且找物赛道产品极多，照抄只能拼美术，必须换一个结构点或换人群。",
  "suggestions": [
   "把「整理房间」换成「药房盘点」或「仓库盘点」：清单变成单据，暂存格变成手持托盘，同一套机制换到 B 端感更强的题材",
   "把暂存 7 格改成「按品类分格的收纳盒」（每格只收一类），约束从数量变成分类，难度曲线更好控也更少挫败",
   "加一条轻成长：每关满星解锁一个「新房间」，用房间收集替代纯关卡列表，给回访一个理由",
   "广告位从弹窗改成「提示 / 清理道具」两个主动入口，它现在最大的差评就是弹窗打断"
  ],
  "risks": [
   "一关一张精修插画，美术成本随关卡线性增长，做 50 关就是 50 张商业插画",
   "找物/收纳赛道同类极多（同榜的《不停找找找》《疯狂收杂物》都在打同一批用户），买量价格被抬高",
   "暂存区塞满即卡死的设计对新玩家偏硬，首关不做好引导会直接流失"
  ],
  "effort": "20–30 人日（1 前端 + 1 美术，美术按关卡外包另计）"
 },
