 "play": {
  "core_loop": "培育花种→种入花田浇水→等 CD 收获鲜花→完成顾客/居民/宫廷订单换资源→解锁新花种与地皮，一局即一次种植-收获-交付循环，靠体力与订单节奏驱动每日复访。",
  "highlights": [
   "花开花落的即时收获动画 + 概率掉落「鲜花贺卡」，把单局爽感接到「填地址收真实花束」的线下惊喜",
   "每种花独立升级与品级(凡→仙)收集，提供清晰的长线目标与氪金锚点",
   "好友「偷花」+ 公会竞赛，把单机种植变成轻度社交竞争，提升留存"
  ],
  "innovations": [
   "「种虚拟花、寄真实花束」的线上线下联动营销，是区别于同类模拟经营的最大差异点（属运营创新而非玩法创新）",
   "以女频短剧式逆袭剧情(出轨丈夫→独立养花)做前期吸量包装，剧情嵌而不重"
  ],
  "target_user": "25-45 岁女性向休闲用户，偏好治愈/种田/剧情",
  "monetization": "IAP 内购为主(体力/资源礼包/限定花种)，辅以去广告；付费卡体力和稀缺资源",
  "lifecycle": "长线运营，靠每日订单、公会活动、赛季与限定花种持续拉回收"
 },
 "clone": {
  "verdict": "换肤",
  "rationale": "核心种植-订单循环是成熟模拟经营框架，机制零门槛、技术风险低；真正的差异化在于「花艺题材 + 线下真花」包装与首关留存设计，同题材换皮即可成立。原产品已高度验证，但同类女性向经营赛道拥挤。",
  "suggestions": [
   "换题材到「茶艺工坊 / 汉服裁缝铺 / 宠物美容院」，用同类种植-订单循环替换花艺外壳",
   "保留「线上玩、线下寄实物」的联动作为差异化钩子，但换成低成本的实体周边(贴纸/种子卡)",
   "首关把堆叠层数/资源缺口后移，把失败点推到第 5 关之后以保首留"
  ],
  "risks": [
   "女性向模拟经营品类已饱和，买量 CPA 偏高",
   "「线下寄真花」成本高、难复制，照搬会拖垮毛利",
   "厦门麟贝已凭此 IP 占榜，同题材正面撞车风险高"
  ],
  "effort": "40–60 人日（1 前端 + 1 美术 + 1 策划，基于成熟小游戏基建）"
 },
