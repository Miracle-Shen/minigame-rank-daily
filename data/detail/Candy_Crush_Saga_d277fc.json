 "play": {
  "core_loop": "在棋盘上交换相邻糖果凑成三连消除，四连以上生成特殊糖果，用连锁与特殊糖果在限定步数内完成关卡目标；失败扣生命，靠好友赠送或内购续命。一局 1–3 分钟。",
  "highlights": [
   "消除与连锁的爽脆音效 + 屏幕反馈密度高",
   "特殊糖果（彩色炸弹/条纹）一次清屏的爆发感",
   "Saga 地图的下一关解锁悬念与每日奖励回访钩子",
   "好友生命互赠的轻社交裂变"
  ],
  "innovations": [
   "无实质创新，属成熟三消品类的长线执行优化（特殊糖果组合 + 限时模式如 Gummy Dragons/Bubblegum Pop）"
  ],
  "target_user": "25–45 岁泛休闲、通勤碎片用户",
  "monetization": "IAP 内购（生命/步数/booster/金条）+ 去广告；广告占比极低（King 自述）",
  "lifecycle": "超长线运营，周更关卡 + 赛季活动，2012 年至今"
 },
 "clone": {
  "verdict": "不建议",
  "rationale": "三消机制本身可自由复刻，但 Candy Crush 是 King/动视暴雪旗下全球顶级 IP，品牌与用户认知垄断；赛道已被 Candy Crush、Royal Match 等头部锁死，买量 CPA 极高，新入场者几乎无差异化空间。",
  "suggestions": [
   "若要入场，放弃正面竞争，改做细分题材（如「中药房三消」「考古挖掘消除」）",
   "重点做首关留存与卡关难度曲线，而非堆关卡数",
   "用 AI 辅助生成关卡而非手工设计 1.5 万关"
  ],
  "risks": [
   "Candy Crush 商标与 IP 侵权风险",
   "三消买量成本极高、ROI 难正",
   "头部产品已占据用户心智"
  ],
  "effort": "40–60 人日（2 前端 + 1 美术 + 0.5 策划）仅做基础三消，不含海量关卡"
 },
