 "play": {
  "core_loop": "选三名异人进 3V3 车轮战，普攻、平招、险招对防御、闪避形成循环克制；靠读对手起手色光做判断，赢下的角色继续留场并回血，5 点体力决定能不能强制脱身。",
  "highlights": [
   "红、蓝、白三色起手提示把「读招」变成明确信号，新手也能靠看颜色做对判断",
   "5 点体力才能发动强制脱身，进攻与留后路每次都要选，博弈从操作转到当下判断",
   "完美闪避后接派生攻击，操作上限留给老手，下限不劝退新手",
   "3V3 车轮战的出场顺序本身就是一层策略，类似田忌赛马",
   "赛璐璐渲染配电影化运镜，过场即动画，原著名场面 1:1 重现"
  ],
  "innovations": [
   "把传统格斗的搓招换成「一键技能 + 猜拳克制 + 体力资源」，胜负从操作精度转向当下判断",
   "「身外身」作为独立战术技能，带类似霸体的反制效果，形成第二层博弈",
   "PVP 与 PVE 各一套独立技能模组，剧情战与对战的招式互不将就"
  ],
  "target_user": "18-35 岁动作与格斗游戏用户，以及《一人之下》原著粉",
  "monetization": "以外观付费为主，角色可通过任务与签到免费获取，PVP 无属性加成；预约期以礼包抽奖拉预约",
  "lifecycle": "长线运营，2026 年 12 月公测，靠赛季、新异人与剧情章节续命"
 },
